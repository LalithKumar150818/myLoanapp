SECRET_KEY=replace-with-a-random-secret

# Choose one real SMS provider.
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Or configure a provider webhook instead:
# SMS_PROVIDER=webhook
# SMS_GATEWAY_URL=https://your-sms-provider.example/send

# Testing only. Keep disabled in production.
OTP_DEV_MODE=false
